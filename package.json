{
  "name": "glkvm-cli",
  "version": "0.1.0",
  "description": "CLI for GL.iNet (PiKVM-based) KVM-over-IP devices: snapshots, keystrokes, ATX power, switch ports",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nehpz/glkvm-cli.git"
  },
  "bin": {
    "glkvm": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "check": "biome ci . && tsc --noEmit && bun test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/glkvm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
